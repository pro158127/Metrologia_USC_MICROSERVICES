generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL_LOCAL")
  extensions = [vector]
}

model Usuario {
  idUsuario         Int                @id @default(autoincrement()) @map("ID_USUARIO_AUTO_INCREMENT")
  nombreCompleto    String             @map("NOMBRE_COMPLETO")
  contraseña       String
  idRol             Int                @map("ID_ROL_FK")
  correo            String             @unique @map("CORREO_INSTITUCION")
  createdAt         DateTime           @default(now()) @map("CREATED_AT")
  updatedAt         DateTime?          @updatedAt @map("UPDATE_AT")
  estado            Boolean            @map("ESTADO")
  intentos          Int                @default(0)
  elminado          Boolean            @default(false)
  auditLogs         AuditLog[]
  calibraciones     Calibracion[]
  notificaciones    Notificacion[]
  rol               Roles              @relation(fields: [idRol], references: [idRol])
  documento_version VersionDocumento[]
  plantilla_version VersionPlantilla[]
  historial_estados HistorialEstadoCotizacion[]
  instrumentos_asignados OrdenTrabajoDetalle[]

  @@map("usuarios")
}

model Roles {
  idRol             Int       @id @default(autoincrement()) @map("ID_ROL_INCREMENT")
  nombreRol         String    @map("NOMBRE_ROL")
  permisos          Json      @map("PERMISOS_JSON")
  justificacion     String    @map("JUSTIFICACION")
  directrizDirector Boolean   @map("DIRECTRIZ_DIRECTOR")
  usuarios          Usuario[]

  @@map("roles")
}

model AuditLog {
  action    String
  tableName String
  recordId  String
  userId    Int      @map("USER_ID")
  createdAt DateTime @default(now())
  details   Json
  ip        String
  id        Int      @id @default(autoincrement()) @map("ID_AUDIT")
  user      Usuario  @relation(fields: [userId], references: [idUsuario])

  @@map("audit_logs")
}

model Notificacion {
  idNotificacion Int      @id @default(autoincrement()) @map("ID_NOTIFICACION")
  idUsuario      Int      @map("ID_USUARIO_FK")
  mensaje        String   @map("MENSAJE")
  modulo         String   @map("MODULO")
  visto          Boolean  @default(false) @map("VISTO")
  nivelPrioridad String   @map("NIVEL_PRIORIDAD")
  createdAt      DateTime @default(now()) @map("CREATED_AT")
  usuario        Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@map("notificaciones")
}

model Tarifa {
  idTarifa         Int               @id @default(autoincrement()) @map("ID_TARIFA")
  magnitud         String            @map("MAGNITUD")
  tipoServicio     String            @map("TIPO_SERVICIO")
  estado           String            @default("ACTIVO") @map("ESTADO")
  Instrumento      String            @default("n/a")
  historial        HistorialTarifa[]
  Norma            String     @default("n/a")

  @@unique([magnitud, Instrumento, Norma, tipoServicio], name: "UQ_tarifa_identidad")
  @@map("tarifas")
}

model HistorialTarifa {
  idHistorial Int       @id @default(autoincrement()) @map("ID_HISTORIAL")
  idTarifa    Int       @map("ID_TARIFA_FK")
  fechaInicio DateTime  @default(now()) @map("FECHA_INICIO")
  fechaFin    DateTime? @map("FECHA_FIN")
  precioU     Decimal   @map("PRECIO_U") @db.Decimal(12, 2)
  tarifa      Tarifa    @relation(fields: [idTarifa], references: [idTarifa], onDelete: Cascade)

  @@index([idTarifa, fechaInicio, fechaFin])
  @@unique([idTarifa, fechaInicio], name: "UQ_tarifa_fecha_inicio")
  @@map("historial_tarifas")
}

model ParametroSistema {
  idParametro      Int                 @id @default(autoincrement()) @map("ID_PARAMETRO")
  clave            String              @unique @map("CLAVE")
  codigoScript     String?             @map("CODIGO_SCRIPT")
  frecuencia       FrecuenciaEjecucion @default(UNA_VEZ) @map("FRECUENCIA")
  expresionCron    String?             @map("EXPRESION_CRON")
  proximaEjecucion DateTime?           @map("PROXIMA_EJECUCION")
  ultimaEjecucion  DateTime?           @map("ULTIMA_EJECUCION")

  @@index([proximaEjecucion])
  @@map("parametros_sistema")
}

model Plantilla {
  idPlantilla Int                @id @default(autoincrement()) @map("ID_PLANTILLA")
  modulo      String             @default("COTIZACIONES") @map("MODULO")
  activa      Boolean            @default(true) @map("ACTIVA")
  nombre      String             @map("NOMBRE")
  versiones   VersionPlantilla[]

  @@map("plantillas")
}

model Cliente {
  idCliente      Int            @id @default(autoincrement()) @map("ID_CLIENTE")
  nitCedula      String         @unique @map("NIT")
  razonSocial    String         @map("RAZON_SOCIAL")
  correo         String         @map("CORREO")
  nombreContacto String?        @map("NOMBRE_CONTACTO")
  telefono       String?        @map("TELEFONO")
  observacion    String?        @map("OBSERVACION")
  idRutDocumento Int?           @unique @map("ID_RUT_DOCUMENTO_FK")
  status         statuscliente  @default(ACTIVO)
  createat       DateTime       @default(now())
  dirrecion   String         @default("n/a")
  updatedAt      DateTime       @default(now())
  ciudad         String?        @default("Cali")
  tipoCliente    tipocliente    @default(NATURAL) @map("TIPO_CLIENTE")
  rutDocumento   Documento?     @relation("ClienteRut", fields: [idRutDocumento], references: [idDocumento])
  cotizaciones   Cotizacion[]
  ordenes        OrdenTrabajo[]
  facturas       Factura[]

  @@map("clientes")
}

enum Estados {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  EN_SEGUIMIENTO
}
model Cotizacion {
  idCotizacion Int                 @id @default(autoincrement()) @map("ID_COTIZACION")
  codigo       String              @unique @map("CODIGO_COTIZACION")
  idCliente    Int?                @map("ID_CLIENTE_FK")
  montoTotal   Decimal?            @map("MONTO_TOTAL") @db.Decimal(12, 2)
  createdAt    DateTime            @default(now()) @map("CREATED_AT")
  updatedAt    DateTime?           @updatedAt @map("UPDATED_AT")
  viaticos     Decimal?            @default(0) @db.Decimal(12, 2)
  estado       Estados             @default(BORRADOR) @map("ESTADO")
  enviar       Boolean        @default(false)
  descuento    Int?                @default(0)
  detalles     CotizacionDetalle[]
  cliente      Cliente?            @relation(fields: [idCliente], references: [idCliente])
  documentos   Documento[]
  ordenes      OrdenTrabajo[]
  recepciones  RecepcionEquipo[]
  Historiacambios HistorialCambios[]
  historialEstados HistorialEstadoCotizacion[]

  @@index([createdAt])
  @@map("cotizaciones")
}

model HistorialCambios {
  id                      String   @id @default(uuid())
  numeroVersion           String   @map("numero_version")
  fechaCambio             DateTime @map("fecha_cambio")
  descripcion             String   @db.Text
  requiereValidacionHoja  Boolean  @default(false) @map("requiere_validacion_hoja")
  observaciones           String?  @db.Text
  aprobo                  String   @map("aprobo")
  
  idCotizacion            Int      @map("id_cotizacion")
  cotizacion              Cotizacion @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade)
  
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("historial_cambios")
}

model HistorialEstadoCotizacion {
  id             Int        @id @default(autoincrement()) @map("ID_HISTORIAL")
  idCotizacion   Int        @map("ID_COTIZACION_FK")
  estadoAnterior Estados?   @map("ESTADO_ANTERIOR")
  estadoNuevo    Estados    @map("ESTADO_NUEVO") @default(APROBADA)
  idUsuario      Int        @map("ID_USUARIO_FK") 
  createdAt      DateTime   @default(now()) @map("CREATED_AT")

  cotizacion     Cotizacion @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade)
  usuario        Usuario?    @relation(fields: [idUsuario], references: [idUsuario])

  @@index([idCotizacion])
  @@map("historial_estado_cotizacion")
}



model CotizacionDetalle {
  idDetalle         Int        @id @default(autoincrement()) @map("ID_DETALLE")
  idCotizacion      Int        @map("ID_COTIZACION_FK")
  equipoDescripcion String     @map("EQUIPO_DESCRIPCION")
  tipoServicio      String     @map("TIPO_SERVICIO")
  magnitud          String     @map("MAGNITUD")
  normaTecnica      String?    @map("NORMA_TECNICA")
  cantidad          Int        @map("CANTIDAD")
  valorUnitario     Decimal    @map("VALOR_UNITARIO") @db.Decimal(12, 2)
  valorTotal        Decimal    @map("VALOR_TOTAL") @db.Decimal(12, 2)
  cotizacion        Cotizacion @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade)
  sitio             String?

  @@map("cotizacion_detalles")
}
enum estadopay {
  PAGADO
  PENDINDE
  VENCIDA

}

model OrdenTrabajo {
  //seccion1
  idOrdenTrabajo         Int                   @id @default(autoincrement()) @map("ID_ORDEN_TRABAJO")
  codigo                 String                @unique @map("CODIGO_OT")
  idCotizacion           Int?                  @map("ID_COTIZACION_FK")
  idCliente              Int?                  @map("ID_CLIENTE_FK")
  correoCertificado      String?               @map("CORREO_CERTIFICADO")
  correoFactura          String?               @map("CORREO_FACTURA")
  fechaLimiteFacturacion DateTime?             @map("FECHA_LIMITE_FACTURACION")
  NIT                   String ?                @default("sin nit")
  dirrecion             String?                 @default("sin dirreccion")
  ciudad                String ?                @default("sin ciudad")

  //intrumentos
 instrumentos           OrdenTrabajoDetalle[]

//informacion de calibracion 

  esInternoUSC           Boolean ?              @default(false) @map("ES_INTERNO_USC")
  esEnSitio              Boolean  ?             @default(false) @map("ES_EN_SITIO")
  esLabPermanente        Boolean  ?             @default(true) @map("ES_LAB_PERMANENTE")
  personaContacto        String?               @map("PERSONA_CONTACTO")
  telefonoContacto       String?               @map("TELEFONO_CONTACTO")
  fechaCalibracion       DateTime?             @map("FECHA_CALIBRACION")
    hora                   DateTime? @default(now())

 ///informacion de solicitante
Razon_social            String?              @default("sin razon_social")
dirrecion_solcitante            String?                 @default("sin dirreccion")
personaContacto_solicitante       String?               @map("PERSONA_CONTACT_SOLCITANTE")
ciudad_solcitante              String ?                @default("sin ciudad")
NIT_solicitante                  String ?                @default("sin nit")
telefonoContacto_solcitante       String?               @map("TELEFONO_CONTACTO_SOLICITANTE")


//consecutivos y fecha de diligenciamentos


  no_orden_trabajo     String?                @default("n/a")
  no_cotizacion         String?         @default("n/a")
  responsable            String?               @map("RESPONSABLE")
  fecha_dilgenciamento      DateTime?             @map("FECHA_CALIBRACION_DILIGENCIAMENTO")
  requireAnexo           Boolean ?              @default(false) @map("REQUIERE_ANEXO")
/// OBSERVACIONES
  observaciones          String?               @map("OBSERVACIONES")



              
  estado                 EstadoOT?                @default(Creada) 
  estadoRevision         String?                @default("PENDIENTE_REVISION") @map("ESTADO_REVISION")
  motivoRechazo          String?               @map("MOTIVO_RECHAZO")
  createdAt              DateTime?             @default(now()) @map("CREATED_AT")
  estado_pago            estadopay?             @default(PAGADO)
  alertamessag           String?               @default("sin novedades")
  
  documentos     Documento[] @relation("OrdenDocumentos")
  pago           Documento[] @relation("OrdenPago") // O Documento? si es 1 a 1 / opcional
 
  cliente                Cliente?              @relation(fields: [idCliente], references: [idCliente])
  cotizacion             Cotizacion?           @relation(fields: [idCotizacion], references: [idCotizacion])
  recepciones            RecepcionEquipo[]
  facturas               Factura[]

  @@index([codigo])
  @@index([fechaCalibracion])
  @@map("ordenes_trabajo")
}

model Factura {
  idFactura      Int           @id @default(autoincrement()) @map("ID_FACTURA")
  numero         String        @unique @map("NUMERO_FACTURA")
  idOrdenTrabajo Int?          @map("ID_ORDEN_TRABAJO_FK")
  idCliente      Int?          @map("ID_CLIENTE_FK")
  fecha          DateTime      @default(now()) @map("FECHA")
  valor          Decimal       @map("VALOR") @db.Decimal(12, 2)
  estado         String        @default("EMITIDA") @map("ESTADO")
  observacion    String?       @map("OBSERVACION")
  ordenTrabajo   OrdenTrabajo? @relation(fields: [idOrdenTrabajo], references: [idOrdenTrabajo])
  cliente        Cliente?      @relation(fields: [idCliente], references: [idCliente])

  @@index([idOrdenTrabajo])
  @@index([idCliente])
  @@map("facturas")
}

model OrdenTrabajoDetalle {
  idDetalle              Int          @id @default(autoincrement()) @map("ID_DETALLE")
  idOrdenTrabajo         Int          @map("ID_ORDEN_TRABAJO_FK")
  item                   Int          @map("ITEM")
  tipoServicio           String       @map("TIPO_SERVICIO")
  instrumento            String       @map("INSTRUMENTO")
  fabricante             String?      @map("FABRICANTE")
  modelo                 String?      @map("MODELO")
  serie                  String?      @map("SERIE")
  codigoInventario       String?      @map("CODIGO_INVENTARIO")
  ubicacion              String?      @map("UBICACION")
  puntosCalibrar         String[]     @map("PUNTOS_CALIBRAR")
  unidad                 String?      @map("UNIDAD")
  intervaloRango         String?      @map("INTERVALO_RANGO")
  resolucion             String?      @map("RESOLUCION")
  asignado                Int       
  // NUEVO CAMPO AGREGADO
  declaracionConformidad Boolean      @default(false) @map("DECLARACION_CONFORMIDAD")
  asginados              Usuario?      @relation(fields: [asignado],references:[idUsuario],onDelete:Cascade)
  limiteControlEMC       String?      @map("LIMITE_CONTROL_EMC")
  docEspecificacion      String?      @map("DOC_ESPECIFICACION")
  reglaDecision          String?      @map("REGLA_DECISION")
  ordenTrabajo           OrdenTrabajo @relation(fields: [idOrdenTrabajo], references: [idOrdenTrabajo], onDelete:Cascade)


  @@map("orden_trabajo_detalles")
}

model RecepcionEquipo {
  idRecepcion          Int                      @id @default(autoincrement()) @map("ID_RECEPCION")
  codigo               String                   @unique @map("CODIGO_RECEPCION")
  idCotizacion         Int?                     @map("ID_COTIZACION_FK")
  idOrdenTrabajo       Int?                     @map("ID_ORDEN_TRABAJO_FK")
  solicitante          String                   @map("SOLICITANTE")
  nombreEntrega        String?                  @map("NOMBRE_ENTREGA")
  sitioCalibracion     String                   @map("SITIO_CALIBRACION")
  fechaRecepcion       DateTime                 @default(now()) @map("FECHA_RECEPCION")
  fechaSalida          DateTime?                @map("FECHA_SALIDA")
  nombreRecibe         String?                  @map("NOMBRE_RECIBE")
  nombreEmpaca         String?                  @map("NOMBRE_EMPACA")
  nombreCalibra        String?                  @map("NOMBRE_CALIBRA")
  nombreRecibeServicio String?                  @map("NOMBRE_RECIBE_SERVICIO")
  accesorios           String?                  @map("ACCESORIOS")
  pruebasCompletas     Boolean                  @default(true) @map("PRUEBAS_COMPLETAS")
  observacionesPruebas String?                  @map("OBSERVACIONES_PRUEBAS")
  estado               String                   @default("RECIBIDO") @map("ESTADO")
  createdAt            DateTime                 @default(now()) @map("CREATED_AT")
  documentos           Documento[]
  instrumentos         RecepcionEquipoDetalle[]
  cotizacion           Cotizacion?              @relation(fields: [idCotizacion], references: [idCotizacion])
  ordenTrabajo         OrdenTrabajo?            @relation(fields: [idOrdenTrabajo], references: [idOrdenTrabajo])

  @@index([createdAt])
  @@map("recepciones_equipo")
}

model RecepcionEquipoDetalle {
  idInstrumento    Int             @id @default(autoincrement()) @map("ID_INSTRUMENTO")
  idRecepcion      Int             @map("ID_RECEPCION_FK")
  instrumento      String          @map("INSTRUMENTO")
  marca            String?         @map("MARCA")
  modelo           String?         @map("MODELO")
  serie            String?         @map("SERIE")
  codigoInventario String?         @map("CODIGO_INVENTARIO")
  resolucion       String?         @map("RESOLUCION")
  tipoSensorTemp   String?         @map("TIPO_SENSOR_TEMP")
  estadoIBC        Json?           @map("ESTADO_IBC")
  estampilla       String?         @map("ESTAMPILLA")
  observaciones    String?         @map("OBSERVACIONES")
  calibracion      Calibracion?
  recepcion        RecepcionEquipo @relation(fields: [idRecepcion], references: [idRecepcion], onDelete: Cascade)

  @@map("recepcion_equipo_detalles")
}

model Calibracion {
  idCalibracion Int                    @id @default(autoincrement()) @map("ID_CALIBRACION")
  idInstrumento Int                    @unique @map("ID_INSTRUMENTO_FK")
  idTecnico     Int                    @map("ID_TECNICO_FK")
  datosTecnicos Json                   @map("DATOS_TECNICOS_JSON")
  observaciones String?                @map("OBSERVACIONES")
  createdAt     DateTime               @default(now()) @map("CREATED_AT")
  instrumento   RecepcionEquipoDetalle @relation(fields: [idInstrumento], references: [idInstrumento])
  tecnico       Usuario                @relation(fields: [idTecnico], references: [idUsuario])
  certificado   Certificado?

  @@map("calibraciones")
}

model Certificado {
  idCertificado Int                @id @default(autoincrement()) @map("ID_CERTIFICADO")
  codigo        String             @unique @map("CODIGO_CERTIFICADO")
  idCalibracion Int                @unique @map("ID_CALIBRACION_FK")
  idDocumento   Int                @map("ID_DOCUMENTO_FK")
  sellos        CertificadoSello[]
  calibracion   Calibracion        @relation(fields: [idCalibracion], references: [idCalibracion])
  documento     Documento          @relation(fields: [idDocumento], references: [idDocumento])

  @@map("certificados")
}

model Documento {
  idDocumento     Int                     @id @default(autoincrement()) @map("ID_DOCUMENTO")
  nombre          String                  @map("NOMBRE")
  rutaUrl         String                  @map("RUTA_URL")
  proveedor       ProveedorAlmacenamiento @default(LOCAL) @map("PROVEEDOR")
  mimeType        String                  @map("MIME_TYPE")
  createdAt       DateTime                @default(now()) @map("CREATED_AT")
  idCotizacion    Int?                    @map("ID_COTIZACION_FK")
  idOrdenTrabajo  Int?                    @map("ID_ORDEN_TRABAJO_FK")
  idRecepcion     Int?                    @map("ID_RECEPCION_FK")
  idPlantilla     Int?                    @map("ID_PLANTILLA_FK")
  ordenPagoId    Int?
  ordenPago      OrdenTrabajo? @relation("OrdenPago", fields: [ordenPagoId], references: [idOrdenTrabajo])
  certificados    Certificado[]
  clienteRut      Cliente?                @relation("ClienteRut")
  chunksIA        DocumentChunk[]
  cotizacion      Cotizacion?             @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade)
  orden          OrdenTrabajo? @relation("OrdenDocumentos", fields: [idOrdenTrabajo], references: [idOrdenTrabajo])
  recepcion       RecepcionEquipo?        @relation(fields: [idRecepcion], references: [idRecepcion], onDelete: Cascade)
  sellos          Sello[]
  versiones       VersionDocumento[]
  platillaVersion VersionPlantilla[]

  @@index([idCotizacion])
  @@index([idOrdenTrabajo])
  @@index([idRecepcion])
  @@index([idPlantilla])
  @@map("documentos")
}

model VersionPlantilla {
  idVersionPlantilla Int        @id @default(autoincrement()) @map("ID_VERSION_PLANTILLA")
  idPlantilla        Int        @map("ID_PLANTILLA_FK")
  version            Int        @default(1) @map("VERSION")
  mapeoExcelJson     Json?      @map("MAPEO_EXCEL_JSON")
  inputSchema        Json?      @map("INPUT_SCHEMA")
  mappingConfig      Json?      @map("MAPPING_CONFIG")
  mapeoConfig        Json?      @map("MAPEO_CONFIG")
  estado             String     @default("PENDIENTE") @map("ESTADO")
  procesadoEn        DateTime?  @map("PROCESADO_EN")
  errorLog           String?    @map("ERROR_LOG")
  idUsuarioCreador   Int        @map("ID_USUARIO_CREADOR_FK")
  createdAt          DateTime   @default(now()) @map("CREATED_AT")
  iddocumentos       Int?       @map("ID_DOCUMENTOS_FK")
  documentos         Documento? @relation(fields: [iddocumentos], references: [idDocumento])
  plantilla          Plantilla  @relation(fields: [idPlantilla], references: [idPlantilla], onDelete: Cascade)
  usuarioCreador     Usuario    @relation(fields: [idUsuarioCreador], references: [idUsuario])

  @@map("version_plantillas")
}

model VersionDocumento {
  idVersion    Int       @id @default(autoincrement()) @map("ID_VERSION")
  idDocumento  Int       @map("ID_DOCUMENTO_FK")
  version      Int       @default(1) @map("VERSION")
  rutaUrl      String    @map("RUTA_URL")
  createdAt    DateTime  @default(now()) @map("CREATED_AT")
  usuario_fk   Int
  content_json Json?
  documento    Documento @relation(fields: [idDocumento], references: [idDocumento], onDelete: Cascade)
  usuario      Usuario   @relation(fields: [usuario_fk], references: [idUsuario])

  @@map("version_documentos")
}

model DocumentChunk {
  idChunk     Int                    @id @default(autoincrement()) @map("ID_CHUNK")
  idDocumento Int                    @map("ID_DOCUMENTO_FK")
  contenido   String                 @map("CONTENIDO")
  embedding   Unsupported("vector")?
  documento   Documento              @relation(fields: [idDocumento], references: [idDocumento], onDelete: Cascade)

  @@map("document_chunks")
}

model Sello {
  idSello      Int                @id @default(autoincrement()) @map("ID_SELLO")
  nombre       String             @map("NOMBRE")
  idDocumento  Int                @map("ID_DOCUMENTO_FK")
  estado       Boolean            @default(true) @map("ESTADO")
  certificados CertificadoSello[]
  documento    Documento          @relation(fields: [idDocumento], references: [idDocumento])

  @@map("sellos")
}

model CertificadoSello {
  idCertificado Int         @map("ID_CERTIFICADO_FK")
  idSello       Int         @map("ID_SELLO_FK")
  certificado   Certificado @relation(fields: [idCertificado], references: [idCertificado])
  sello         Sello       @relation(fields: [idSello], references: [idSello])

  @@id([idCertificado, idSello])
  @@map("certificado_sellos")
}

model PlantillaSello {
  idPlantillaSello Int      @id @default(autoincrement()) @map("ID_PLANTILLA_SELLO")
  nombre           String   @map("NOMBRE")
  descripcion      String?  @map("DESCRIPCION")
  templatePdfKey   String?  @map("TEMPLATE_PDF_KEY")
  documentArea     Json?    @map("DOCUMENT_AREA")
  watermarkAreas   Json?    @map("WATERMARK_AREAS")
  createdAt        DateTime @default(now()) @map("CREATED_AT")
  updatedAt        DateTime @updatedAt @map("UPDATED_AT")

  @@map("plantillas_sellos")
}

enum FrecuenciaEjecucion {
  UNA_VEZ
  DIARIA
  SEMANAL
  PROGRAMADA_CRON
}

enum statuscliente {
  ACTIVO
  INACTIVO
}

enum tipocliente {
  NATURAL
  JURIDICO
}



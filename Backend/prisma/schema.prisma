generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model audit_logs {
  action    String
  tableName String
  recordId  String
  USER_ID   Int
  createdAt DateTime @default(now())
  details   Json
  ip        String
  ID_AUDIT  Int      @id @default(autoincrement())
  usuarios  usuarios @relation(fields: [USER_ID], references: [ID_USUARIO_AUTO_INCREMENT])
}

model calibraciones {
  ID_CALIBRACION            Int                       @id @default(autoincrement())
  ID_INSTRUMENTO_FK         Int                       @unique
  ID_TECNICO_FK             Int
  DATOS_TECNICOS_JSON       Json
  OBSERVACIONES             String?
  CREATED_AT                DateTime                  @default(now())
  recepcion_equipo_detalles recepcion_equipo_detalles @relation(fields: [ID_INSTRUMENTO_FK], references: [ID_INSTRUMENTO])
  usuarios                  usuarios                  @relation(fields: [ID_TECNICO_FK], references: [ID_USUARIO_AUTO_INCREMENT])
  certificados              certificados?
}

model certificado_sellos {
  ID_CERTIFICADO_FK Int
  ID_SELLO_FK       Int
  certificados      certificados @relation(fields: [ID_CERTIFICADO_FK], references: [ID_CERTIFICADO])
  sellos            sellos       @relation(fields: [ID_SELLO_FK], references: [ID_SELLO])

  @@id([ID_CERTIFICADO_FK, ID_SELLO_FK])
}

model certificados {
  ID_CERTIFICADO     Int                  @id @default(autoincrement())
  CODIGO_CERTIFICADO String               @unique
  ID_CALIBRACION_FK  Int                  @unique
  ID_DOCUMENTO_FK    Int
  certificado_sellos certificado_sellos[]
  calibraciones      calibraciones        @relation(fields: [ID_CALIBRACION_FK], references: [ID_CALIBRACION])
  documentos         documentos           @relation(fields: [ID_DOCUMENTO_FK], references: [ID_DOCUMENTO])
}

model clientes {
  ID_CLIENTE          Int               @id @default(autoincrement())
  NIT                 String            @unique
  RAZON_SOCIAL        String
  CORREO              String
  NOMBRE_CONTACTO     String?
  TELEFONO            String?
  OBSERVACION         String?
  ID_RUT_DOCUMENTO_FK Int?              @unique
  status              statuscliente     @default(ACTIVO)
  createat            DateTime          @default(now())
  dirrecion           String            @default("n/a")
  updatedAt           DateTime          @default(now())
  ciudad              String?           @default("Cali")
  TIPO_CLIENTE        tipocliente       @default(NATURAL)
  documentos          documentos?       @relation(fields: [ID_RUT_DOCUMENTO_FK], references: [ID_DOCUMENTO])
  cotizaciones        cotizaciones[]
  ordenes_trabajo     ordenes_trabajo[]
  tramites            tramites[]
}

model cotizacion_detalles {
  ID_DETALLE         Int          @id @default(autoincrement())
  ID_COTIZACION_FK   Int
  EQUIPO_DESCRIPCION String
  TIPO_SERVICIO      String
  MAGNITUD           String
  NORMA_TECNICA      String?
  CANTIDAD           Int
  VALOR_UNITARIO     Decimal      @db.Decimal(12, 2)
  VALOR_TOTAL        Decimal      @db.Decimal(12, 2)
  cotizaciones       cotizaciones @relation(fields: [ID_COTIZACION_FK], references: [ID_COTIZACION], onDelete: Cascade)
}

model cotizaciones {
  ID_COTIZACION       Int                   @id @default(autoincrement())
  CODIGO_COTIZACION   String                @unique
  ID_TRAMITE_FK       Int?
  ID_CLIENTE_FK       Int?
  CONTACTO_NOMBRE     String?
  CONTACTO_EMAIL      String?
  CONTACTO_TELEFONO   String?
  ES_INTERNO_USC      Boolean               @default(false)
  MONTO_TOTAL         Decimal               @db.Decimal(12, 2)
  ESTADO              String                @default("BORRADOR")
  CREATED_AT          DateTime              @default(now())
  UPDATED_AT          DateTime?
  viaticos            Decimal?              @default(0) @db.Decimal(12, 2)
  cotizacion_detalles cotizacion_detalles[]
  clientes            clientes?             @relation(fields: [ID_CLIENTE_FK], references: [ID_CLIENTE])
  tramites            tramites?             @relation(fields: [ID_TRAMITE_FK], references: [ID_TRAMITE])
  documentos          documentos[]
  ordenes_trabajo     ordenes_trabajo[]
  recepciones_equipo  recepciones_equipo[]

  @@index([CREATED_AT])
}

model document_chunks {
  ID_CHUNK        Int                    @id @default(autoincrement())
  ID_DOCUMENTO_FK Int
  CONTENIDO       String
  embedding       Unsupported("vector")?
  documentos      documentos             @relation(fields: [ID_DOCUMENTO_FK], references: [ID_DOCUMENTO], onDelete: Cascade)
}

model documentos {
  ID_DOCUMENTO        Int                     @id @default(autoincrement())
  NOMBRE              String
  RUTA_URL            String
  PROVEEDOR           ProveedorAlmacenamiento @default(LOCAL)
  MIME_TYPE           String
  CREATED_AT          DateTime                @default(now())
  ID_COTIZACION_FK    Int?
  ID_ORDEN_TRABAJO_FK Int?
  ID_RECEPCION_FK     Int?
  ID_TRAMITE_FK       Int?
  ID_PLANTILLA_FK     Int?
  certificados        certificados[]
  clientes            clientes?
  document_chunks     document_chunks[]
  cotizaciones        cotizaciones?           @relation(fields: [ID_COTIZACION_FK], references: [ID_COTIZACION], onDelete: Cascade)
  ordenes_trabajo     ordenes_trabajo?        @relation(fields: [ID_ORDEN_TRABAJO_FK], references: [ID_ORDEN_TRABAJO], onDelete: Cascade)
  recepciones_equipo  recepciones_equipo?     @relation(fields: [ID_RECEPCION_FK], references: [ID_RECEPCION], onDelete: Cascade)
  tramites            tramites?               @relation(fields: [ID_TRAMITE_FK], references: [ID_TRAMITE], onDelete: Cascade)
  sellos              sellos[]
  version_documentos  version_documentos[]
  version_plantillas  version_plantillas[]

  @@index([ID_COTIZACION_FK])
  @@index([ID_ORDEN_TRABAJO_FK])
  @@index([ID_PLANTILLA_FK])
  @@index([ID_RECEPCION_FK])
  @@index([ID_TRAMITE_FK])
}

model historial_tarifas {
  ID_HISTORIAL  Int       @id @default(autoincrement())
  ID_TARIFA_FK  Int
  PRECIO_MINIMO Decimal   @db.Decimal(12, 2)
  FECHA_INICIO  DateTime  @default(now())
  FECHA_FIN     DateTime?
  tarifas       tarifas   @relation(fields: [ID_TARIFA_FK], references: [ID_TARIFA], onDelete: Cascade)

  @@index([ID_TARIFA_FK, FECHA_INICIO, FECHA_FIN])
}

model notificaciones {
  ID_NOTIFICACION Int      @id @default(autoincrement())
  ID_USUARIO_FK   Int
  MENSAJE         String
  MODULO          String
  VISTO           Boolean  @default(false)
  NIVEL_PRIORIDAD String
  CREATED_AT      DateTime @default(now())
  usuarios        usuarios @relation(fields: [ID_USUARIO_FK], references: [ID_USUARIO_AUTO_INCREMENT], onDelete: Cascade)
}

model orden_trabajo_detalles {
  ID_DETALLE              Int             @id @default(autoincrement())
  ID_ORDEN_TRABAJO_FK     Int
  ITEM                    Int
  TIPO_SERVICIO           String
  INSTRUMENTO             String
  FABRICANTE              String?
  MODELO                  String?
  SERIE                   String?
  CODIGO_INVENTARIO       String?
  UBICACION               String?
  PUNTOS_CALIBRAR         String[]
  UNIDAD                  String?
  INTERVALO_RANGO         String?
  RESOLUCION              String?
  DECLARACION_CONFORMIDAD Boolean         @default(false)
  LIMITE_CONTROL_EMC      String?
  DOC_ESPECIFICACION      String?
  REGLA_DECISION          String?
  ordenes_trabajo         ordenes_trabajo @relation(fields: [ID_ORDEN_TRABAJO_FK], references: [ID_ORDEN_TRABAJO], onDelete: Cascade)
}

model ordenes_trabajo {
  ID_ORDEN_TRABAJO         Int                      @id @default(autoincrement())
  CODIGO_OT                String                   @unique
  ID_TRAMITE_FK            Int?
  ID_COTIZACION_FK         Int?
  ID_CLIENTE_FK            Int?
  CORREO_CERTIFICADO       String?
  CORREO_FACTURA           String?
  FECHA_LIMITE_FACTURACION DateTime?
  ES_INTERNO_USC           Boolean                  @default(false)
  ES_EN_SITIO              Boolean                  @default(false)
  ES_LAB_PERMANENTE        Boolean                  @default(true)
  PERSONA_CONTACTO         String?
  TELEFONO_CONTACTO        String?
  FECHA_CALIBRACION        DateTime?
  RESPONSABLE              String?
  OBSERVACIONES            String?
  ESTADO                   String                   @default("EN_PROCESO")
  ESTADO_REVISION          String                   @default("PENDIENTE_REVISION")
  MOTIVO_RECHAZO           String?
  CREATED_AT               DateTime                 @default(now())
  documentos               documentos[]
  orden_trabajo_detalles   orden_trabajo_detalles[]
  clientes                 clientes?                @relation(fields: [ID_CLIENTE_FK], references: [ID_CLIENTE])
  cotizaciones             cotizaciones?            @relation(fields: [ID_COTIZACION_FK], references: [ID_COTIZACION])
  tramites                 tramites?                @relation(fields: [ID_TRAMITE_FK], references: [ID_TRAMITE])
  recepciones_equipo       recepciones_equipo[]

  @@index([CODIGO_OT])
  @@index([FECHA_CALIBRACION])
}

model parametros_sistema {
  ID_PARAMETRO      Int                 @id @default(autoincrement())
  CLAVE             String              @unique
  CODIGO_SCRIPT     String?
  FRECUENCIA        FrecuenciaEjecucion @default(UNA_VEZ)
  EXPRESION_CRON    String?
  PROXIMA_EJECUCION DateTime?
  ULTIMA_EJECUCION  DateTime?

  @@index([PROXIMA_EJECUCION])
}

model plantillas {
  ID_PLANTILLA       Int                  @id @default(autoincrement())
  MODULO             String               @default("COTIZACIONES")
  ACTIVA             Boolean              @default(true)
  NOMBRE             String
  version_plantillas version_plantillas[]
}

model recepcion_equipo_detalles {
  ID_INSTRUMENTO     Int                @id @default(autoincrement())
  ID_RECEPCION_FK    Int
  INSTRUMENTO        String
  MARCA              String?
  MODELO             String?
  SERIE              String?
  CODIGO_INVENTARIO  String?
  RESOLUCION         String?
  TIPO_SENSOR_TEMP   String?
  ESTADO_IBC         Json?
  ESTAMPILLA         String?
  OBSERVACIONES      String?
  calibraciones      calibraciones?
  recepciones_equipo recepciones_equipo @relation(fields: [ID_RECEPCION_FK], references: [ID_RECEPCION], onDelete: Cascade)
}

model recepciones_equipo {
  ID_RECEPCION              Int                         @id @default(autoincrement())
  CODIGO_RECEPCION          String                      @unique
  ID_TRAMITE_FK             Int?
  ID_COTIZACION_FK          Int?
  ID_ORDEN_TRABAJO_FK       Int?
  SOLICITANTE               String
  NOMBRE_ENTREGA            String?
  SITIO_CALIBRACION         String
  FECHA_RECEPCION           DateTime                    @default(now())
  FECHA_SALIDA              DateTime?
  NOMBRE_RECIBE             String?
  NOMBRE_EMPACA             String?
  NOMBRE_CALIBRA            String?
  NOMBRE_RECIBE_SERVICIO    String?
  ACCESORIOS                String?
  PRUEBAS_COMPLETAS         Boolean                     @default(true)
  OBSERVACIONES_PRUEBAS     String?
  ESTADO                    String                      @default("RECIBIDO")
  CREATED_AT                DateTime                    @default(now())
  documentos                documentos[]
  recepcion_equipo_detalles recepcion_equipo_detalles[]
  cotizaciones              cotizaciones?               @relation(fields: [ID_COTIZACION_FK], references: [ID_COTIZACION])
  ordenes_trabajo           ordenes_trabajo?            @relation(fields: [ID_ORDEN_TRABAJO_FK], references: [ID_ORDEN_TRABAJO])
  tramites                  tramites?                   @relation(fields: [ID_TRAMITE_FK], references: [ID_TRAMITE])

  @@index([CREATED_AT])
}

model roles {
  ID_ROL_INCREMENT   Int        @id @default(autoincrement())
  NOMBRE_ROL         String
  PERMISOS_JSON      Json
  JUSTIFICACION      String
  DIRECTRIZ_DIRECTOR Boolean
  usuarios           usuarios[]
}

model sellos {
  ID_SELLO           Int                  @id @default(autoincrement())
  NOMBRE             String
  ID_DOCUMENTO_FK    Int
  ESTADO             Boolean              @default(true)
  certificado_sellos certificado_sellos[]
  documentos         documentos           @relation(fields: [ID_DOCUMENTO_FK], references: [ID_DOCUMENTO])
}

model tarifas {
  ID_TARIFA         Int                 @id @default(autoincrement())
  MAGNITUD          String
  TIPO_SERVICIO     String
  ESTADO            String              @default("ACTIVO")
  historial_tarifas historial_tarifas[]
}

model tramites {
  ID_TRAMITE         Int                  @id @default(autoincrement())
  CODIGO_TRAMITE     String               @unique
  ID_CLIENTE_FK      Int?
  ESTADO_FLUJO       String               @default("EN_PROCESO")
  CREATED_AT         DateTime             @default(now())
  cotizaciones       cotizaciones[]
  documentos         documentos[]
  ordenes_trabajo    ordenes_trabajo[]
  recepciones_equipo recepciones_equipo[]
  clientes           clientes?            @relation(fields: [ID_CLIENTE_FK], references: [ID_CLIENTE])
}

model usuarios {
  ID_USUARIO_AUTO_INCREMENT Int                  @id @default(autoincrement())
  NOMBRE_COMPLETO           String
  contrase_a                String               @map("contraseña")
  ID_ROL_FK                 Int
  CORREO_INSTITUCION        String               @unique
  CREATED_AT                DateTime             @default(now())
  UPDATE_AT                 DateTime?
  ESTADO                    Boolean
  intentos                  Int                  @default(0)
  elminado                  Boolean              @default(false)
  audit_logs                audit_logs[]
  calibraciones             calibraciones[]
  notificaciones            notificaciones[]
  roles                     roles                @relation(fields: [ID_ROL_FK], references: [ID_ROL_INCREMENT])
  version_documentos        version_documentos[]
  version_plantillas        version_plantillas[]
}

model version_documentos {
  ID_VERSION      Int        @id @default(autoincrement())
  ID_DOCUMENTO_FK Int
  VERSION         Int        @default(1)
  RUTA_URL        String
  CREATED_AT      DateTime   @default(now())
  usuario_fk      Int
  documentos      documentos @relation(fields: [ID_DOCUMENTO_FK], references: [ID_DOCUMENTO], onDelete: Cascade)
  usuarios        usuarios   @relation(fields: [usuario_fk], references: [ID_USUARIO_AUTO_INCREMENT])
}

model version_plantillas {
  ID_VERSION_PLANTILLA  Int         @id @default(autoincrement())
  ID_PLANTILLA_FK       Int
  VERSION               Int         @default(1)
  MAPEO_EXCEL_JSON      Json?
  ID_USUARIO_CREADOR_FK Int
  CREATED_AT            DateTime    @default(now())
  ID_DOCUMENTOS_FK      Int?
  documentos            documentos? @relation(fields: [ID_DOCUMENTOS_FK], references: [ID_DOCUMENTO])
  plantillas            plantillas  @relation(fields: [ID_PLANTILLA_FK], references: [ID_PLANTILLA], onDelete: Cascade)
  usuarios              usuarios    @relation(fields: [ID_USUARIO_CREADOR_FK], references: [ID_USUARIO_AUTO_INCREMENT])
}

enum FrecuenciaEjecucion {
  UNA_VEZ
  DIARIA
  SEMANAL
  PROGRAMADA_CRON
}

enum ProveedorAlmacenamiento {
  LOCAL
  AWS_S3
  GOOGLE_DRIVE
}

enum statuscliente {
  ACTIVO
  INACTIVO
}

enum tipocliente {
  NATURAL
  JURIDICO
}

FROM node:22-alpine

# Activar pnpm nativo
RUN corepack enable && corepack prepare pnpm@9 --activate

# Establecer el directorio de trabajo sincronizado con el docker-compose
WORKDIR /workspace/Backend

# 🔥 INSTALACIÓN DEL MOTOR: Python (tu pipeline) + LibreOffice + Fuentes tipográficas
RUN apk add --no-cache \
    python3 py3-pandas py3-openpyxl \
    libreoffice \
    postgresql16-client \
    ttf-dejavu font-liberation

# Cliente MinIO (mc) para espejar el bucket de documentos en los respaldos
RUN curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc

EXPOSE 3001

# El CMD final y el pnpm install se ejecutan desde el docker-compose.yml